# OpenAPI 配置
# 复制为 .env 后填入真实值：cp .env.example .env
OPENAPI_HOST=https://openapi.lingxing.com
OPENAPI_APP_ID=your_app_id
OPENAPI_APP_SECRET=your_app_secret

# 示例配置
# 店铺ID（用于查询 Listing 等接口）
SAMPLE_SID=

# 仓库ID（用于查询库存明细等接口，多个用逗号分隔）
SAMPLE_WID=

# 分页配置
DEFAULT_OFFSET=0
DEFAULT_LENGTH=20
MAX_LENGTH=800
